// MARK: - Checklist items — Korea template (korea-general-v1)
// General Safety
"checklist.item.korea.common.001" = "Safety supervisor and work director confirmed on site";
"checklist.item.korea.common.002" = "Pre-work hazard assessment completed and communicated to workers";
"checklist.item.korea.common.003" = "Safety signs installed, visible, and identifiable";
// Housekeeping
"checklist.item.korea.house.001" = "Walkways and emergency exits free from materials and obstructions";
"checklist.item.korea.house.002" = "Tools and materials stored at designated locations; floor clear";
"checklist.item.korea.house.003" = "Waste removed and work area clean";
// PPE
"checklist.item.korea.ppe.001" = "Workers wearing hard hat, safety shoes, and harness where required";
"checklist.item.korea.ppe.002" = "Task-specific PPE in use (dust mask, goggles, etc. as needed)";
"checklist.item.korea.ppe.003" = "PPE inspected for damage or wear; replacements available on site";
// Fall Risk
"checklist.item.korea.fall.001" = "Safety handrail installed and secure at all elevated edges";
"checklist.item.korea.fall.002" = "Floor openings covered or guarded with barriers";
"checklist.item.korea.fall.003" = "Work platform condition and toe boards in place";
// Electrical
"checklist.item.korea.elec.001" = "Cable insulation intact with no exposed wiring";
"checklist.item.korea.elec.002" = "Distribution board grounded and lockout applied";
"checklist.item.korea.elec.003" = "Temporary wiring rated correctly and properly secured";
// Fire
"checklist.item.korea.fire.001" = "Fire extinguisher accessible, charged, and within inspection date";
"checklist.item.korea.fire.002" = "Flammable materials stored away from work areas";
"checklist.item.korea.fire.003" = "Emergency exits and evacuation routes clear and marked";
// Chemical
"checklist.item.korea.chem.001" = "Chemical containers labeled and properly sealed";
"checklist.item.korea.chem.002" = "Safety Data Sheets (SDS) accessible on site";
"checklist.item.korea.chem.003" = "Spill containment equipment in place and hazard zone marked";
// Forklift
"checklist.item.korea.fork.001" = "Forklift forks, mast, and tires visually inspected before use";
"checklist.item.korea.fork.002" = "Pedestrian and forklift traffic areas separated";
"checklist.item.korea.fork.003" = "Operator confirmed qualified; reverse alarm functional";
// Industrial Robot
"checklist.item.korea.robot.001" = "Robot work zone guarded by safety fence or interlocked barrier";
"checklist.item.korea.robot.002" = "Emergency stop button accessible and confirmed functional";
"checklist.item.korea.robot.003" = "Personnel access to robot operating zone controlled during operation";
// Press Machine
"checklist.item.korea.press.001" = "Press guard (gate, two-hand control, or equivalent) installed and functional";
"checklist.item.korea.press.002" = "Lockout procedure applied during die changes and maintenance";
"checklist.item.korea.press.003" = "Clear floor space and non-slip surface maintained around press";
// Conveyor & Rotating Parts
"checklist.item.korea.conv.001" = "Conveyor and rotating parts guarded with covers or mesh";
"checklist.item.korea.conv.002" = "Emergency stop accessible along conveyor length and confirmed functional";
"checklist.item.korea.conv.003" = "Entanglement hazard controls in place around rotating equipment";
// Crane & Hoist
"checklist.item.korea.crane.001" = "Wire ropes, hooks, and shackles inspected for wear and deformation";
"checklist.item.korea.crane.002" = "Overload limiter and over-winding device confirmed functional";
"checklist.item.korea.crane.003" = "Personnel excluded from lift zone during hoisting operations";
// Confined Space
"checklist.item.korea.conf.001" = "Oxygen level and toxic gas concentration measured before entry";
"checklist.item.korea.conf.002" = "Attendant posted outside entry point; emergency contacts established";
"checklist.item.korea.conf.003" = "Ventilation equipment running and supplied-air gear prepared";
// Emergency Response
"checklist.item.korea.emerg.001" = "Emergency contact list posted at site entrance";
"checklist.item.korea.emerg.002" = "First aid kit location marked and supplies stocked";
"checklist.item.korea.emerg.003" = "Evacuation routes and assembly point clearly marked";

// MARK: - Checklist items — Global template (global-general-v1) — US / OSHA-oriented
// General Safety
"checklist.item.global.common.001" = "Site safety orientation completed and attendance documented";
"checklist.item.global.common.002" = "Job hazard analysis completed and reviewed with the crew before work starts";
"checklist.item.global.common.003" = "Required safety postings and signage visible at the site entrance";
// Housekeeping
"checklist.item.global.house.001" = "Walkways, aisles, and exits clear of materials and debris";
"checklist.item.global.house.002" = "Tools and materials stored in designated areas; floors free of clutter";
"checklist.item.global.house.003" = "Waste and scrap removed; spills cleaned up promptly";
// Walking-Working Surfaces
"checklist.item.global.wws.001" = "Floors and walking surfaces free of trip hazards, holes, and standing water";
"checklist.item.global.wws.002" = "Floor openings and holes covered or guarded and labeled";
"checklist.item.global.wws.003" = "Stairways have secure handrails and treads in good condition";
// Fall Protection
"checklist.item.global.fall.001" = "Unprotected edges and openings 6 ft or higher protected by guardrails, nets, or personal fall arrest (4 ft in general industry)";
"checklist.item.global.fall.002" = "Personal fall arrest equipment inspected and tied off to rated anchor points";
"checklist.item.global.fall.003" = "Holes, skylights, and roof openings covered or guarded to prevent falls";
// Ladders & Scaffolds
"checklist.item.global.ladder.001" = "Ladders inspected, free of defects, and set on stable, level footing";
"checklist.item.global.ladder.002" = "Straight ladders extend about 3 ft above the landing and are secured from movement";
"checklist.item.global.ladder.003" = "Scaffolds fully planked with guardrails and inspected before each shift";
// PPE
"checklist.item.global.ppe.001" = "Workers wearing required head, eye, foot, and high-visibility protection";
"checklist.item.global.ppe.002" = "Hearing protection worn in posted high-noise areas";
"checklist.item.global.ppe.003" = "PPE inspected for damage; replacements available on site";
// Respiratory Protection
"checklist.item.global.resp.001" = "Respirators provided and worn where airborne hazards are present";
"checklist.item.global.resp.002" = "Respirator users are fit-tested and cartridges match the hazard";
"checklist.item.global.resp.003" = "Respirators cleaned, inspected, and stored in clean, sealed containers";
// Hazard Communication
"checklist.item.global.hazcom.001" = "Safety Data Sheets (SDS) available and accessible for all chemicals on site";
"checklist.item.global.hazcom.002" = "Containers labeled with GHS labels identifying contents and hazards";
"checklist.item.global.hazcom.003" = "Workers trained on chemical hazards and the written hazard communication program is available";
// Chemical Storage
"checklist.item.global.chem.001" = "Hazardous chemicals stored by compatibility in labeled, closed containers";
"checklist.item.global.chem.002" = "Flammable liquids kept in approved safety cans and flammable storage cabinets";
"checklist.item.global.chem.003" = "Secondary containment and spill kits available where chemicals are used";
// Electrical
"checklist.item.global.elec.001" = "Cords and cables free of damage with no exposed conductors";
"checklist.item.global.elec.002" = "GFCI protection used for temporary power and wet or outdoor locations";
"checklist.item.global.elec.003" = "Electrical panels labeled, closed, and kept clear with 3 ft of access";
// Lockout/Tagout
"checklist.item.global.loto.001" = "Energy sources isolated, locked, and tagged before servicing equipment";
"checklist.item.global.loto.002" = "Each authorized worker applies their own lock and tag";
"checklist.item.global.loto.003" = "Stored energy released or restrained and a zero-energy state verified";
// Machine Guarding
"checklist.item.global.guard.001" = "Guards in place at points of operation, nip points, and rotating parts";
"checklist.item.global.guard.002" = "Guards secured so they cannot be easily removed or bypassed";
"checklist.item.global.guard.003" = "Emergency stops accessible and functional on powered equipment";
// Fire Prevention
"checklist.item.global.fire.001" = "Fire extinguishers mounted, charged, inspected, and unobstructed";
"checklist.item.global.fire.002" = "Exit routes unobstructed and exit signs illuminated";
"checklist.item.global.fire.003" = "Flammable and combustible materials kept away from ignition sources";
// Hot Work
"checklist.item.global.hotwork.001" = "Hot work permit issued and the area cleared of combustibles";
"checklist.item.global.hotwork.002" = "Fire watch posted with an extinguisher during and after hot work";
"checklist.item.global.hotwork.003" = "Compressed gas cylinders secured upright; hoses and regulators checked for leaks";
// Powered Industrial Trucks
"checklist.item.global.pit.001" = "Operators trained and authorized for the truck type in use";
"checklist.item.global.pit.002" = "Daily pre-use inspection completed (forks, tires, horn, brakes)";
"checklist.item.global.pit.003" = "Pedestrian routes separated; seat belt worn and load within rated capacity";
// Confined Space
"checklist.item.global.conf.001" = "Permit-required confined spaces identified and posted";
"checklist.item.global.conf.002" = "Atmosphere tested (oxygen, flammable, toxic) before and during entry";
"checklist.item.global.conf.003" = "Attendant posted and rescue procedures established before entry";
// Emergency Action Plan
"checklist.item.global.eap.001" = "Written emergency action plan available and evacuation routes posted";
"checklist.item.global.eap.002" = "Exit routes and assembly points marked and unobstructed";
"checklist.item.global.eap.003" = "First aid kits stocked and emergency contacts posted";

// MARK: - US Federal checklist templates (WO LEGAL-3B) — replace the retired mixed
// checklist_global.json in the template picker. General Industry (29 CFR 1910) and
// Construction (29 CFR 1926) are separate templates so no item mixes their thresholds —
// see docs/LEGAL_3B_US_TEMPLATE_SOURCE_AUDIT.md for the full prompt-by-prompt source table.
// Reviewed against official OSHA/eCFR text on 2026-08-09.
"checklist.template.usFederalGeneral.name"      = "U.S. Federal — General Industry";
"checklist.template.usFederalConstruction.name" = "U.S. Federal — Construction";
"us.federalNotice.title" = "Federal OSHA Baseline";
"us.federalNotice.text"  = "Federal OSHA baseline reference only. This tool is not exhaustive and does not determine compliance. OSHA-approved State Plans may have different or more protective requirements; local requirements and employer rules may also apply. Confirm the rules for this workplace.";

// Construction-only category — hand & power tools (29 CFR 1926.300), distinct from general
// industry's stationary-machine "Machine Guarding" (29 CFR 1910.212, Subpart O).
"checklist.category.handPowerTools" = "Hand & Power Tools";

// U.S. Federal — General Industry (us-federal-general-industry-v1)
// Housekeeping — 29 CFR 1910.22
"checklist.item.usGeneral.house.001" = "Are walking-working surfaces kept clean, orderly, and free of hazards such as sharp/protruding objects, loose boards, or spills (29 CFR 1910.22)?";
// Walking-Working Surfaces — 29 CFR 1910.28
"checklist.item.usGeneral.wws.001" = "Are unprotected sides or edges 4 feet (1.2 m) or more above a lower level guarded by a guardrail, safety net, or personal fall protection system (29 CFR 1910.28(b)(1)(i))?";
"checklist.item.usGeneral.wws.002" = "Are holes 4 feet (1.2 m) or more above a lower level covered, guarded, or otherwise protected (29 CFR 1910.28(b)(3)(i))?";
// Ladders — 29 CFR 1910.23
"checklist.item.usGeneral.ladder.001" = "Do portable ladders used for access extend at least 3 feet (0.9 m) above the upper landing surface, or is an equivalent secured handhold provided (29 CFR 1910.23(c)(11))?";
"checklist.item.usGeneral.ladder.002" = "Do employees face the ladder and keep at least one hand in contact with it while climbing (29 CFR 1910.23(b)(11)-(12))?";
// PPE — 29 CFR 1910.132
"checklist.item.usGeneral.ppe.001" = "Has the employer assessed the workplace for hazards requiring PPE and selected PPE appropriate to those hazards (29 CFR 1910.132(d)(1))?";
"checklist.item.usGeneral.ppe.002" = "Is the PPE hazard assessment documented in a written certification (29 CFR 1910.132(d)(2))?";
// Respiratory Protection — 29 CFR 1910.134 (applies only where respirators are necessary/required)
"checklist.item.usGeneral.resp.001" = "Where respirators are necessary to protect employee health or are required by the employer, is there a written respiratory protection program (29 CFR 1910.134(c)(1))?";
"checklist.item.usGeneral.resp.002" = "Where respirators are used, has each wearer completed a medical evaluation and fit test before initial use (29 CFR 1910.134(e), (f))?";
// Hazard Communication — 29 CFR 1910.1200
"checklist.item.usGeneral.hazcom.001" = "Is there a written hazard communication program describing labeling, SDS, and training practices (29 CFR 1910.1200(e))?";
"checklist.item.usGeneral.hazcom.002" = "Are hazardous chemical containers labeled with a product identifier, signal word, hazard statements, and pictograms (29 CFR 1910.1200(f))?";
"checklist.item.usGeneral.hazcom.003" = "Are safety data sheets (SDS) readily accessible to employees during each work shift (29 CFR 1910.1200(g))?";
// Lockout/Tagout — 29 CFR 1910.147
"checklist.item.usGeneral.loto.001" = "For servicing/maintenance where unexpected energization or release of stored energy could injure an employee, is there an energy control (lockout/tagout) procedure (29 CFR 1910.147(c)(1))?";
"checklist.item.usGeneral.loto.002" = "Is lockout/tagout performed only by authorized employees (29 CFR 1910.147(c)(8))?";
// Machine Guarding — 29 CFR 1910.212
"checklist.item.usGeneral.guard.001" = "Are points of operation, ingoing nip points, rotating parts, and other hazardous machine motions guarded (29 CFR 1910.212(a)(1))?";
// Electrical — 29 CFR 1910.303 / 1910.333
"checklist.item.usGeneral.elec.001" = "Is sufficient access and working space maintained around electrical equipment for safe operation and maintenance (29 CFR 1910.303(g)(1))?";
"checklist.item.usGeneral.elec.002" = "Do only qualified persons work on electric circuit parts that have not been deenergized, and do unqualified persons keep the minimum distance from exposed energized parts set out in 29 CFR 1910.333(c)(3)?";
// Powered Industrial Trucks — 29 CFR 1910.178(l)
"checklist.item.usGeneral.pit.001" = "Do only operators who have completed the required training and evaluation operate powered industrial trucks (29 CFR 1910.178(l))?";
// Permit-Required Confined Spaces — 29 CFR 1910.146 (general industry only; excludes construction)
"checklist.item.usGeneral.conf.001" = "Where a permit-required confined space is present, is a written permit space program in place, or is entry effectively prevented (29 CFR 1910.146(c)(3)-(4))?";
// Fire Protection — 29 CFR 1910.157
"checklist.item.usGeneral.fire.001" = "Are portable fire extinguishers provided and mounted/located so they are readily accessible without exposing employees to injury (29 CFR 1910.157(c)(1))?";
"checklist.item.usGeneral.fire.002" = "Where portable fire extinguishers are provided for employee use, have employees been trained in the general principles of their use (29 CFR 1910.157(g)(1))?";
// Hot Work — 29 CFR 1910.252
"checklist.item.usGeneral.hotwork.001" = "Is welding/cutting performed only in areas made fire-safe, with combustibles removed or protected within the required radius (29 CFR 1910.252(a)(2)(vii), (xv))?";
"checklist.item.usGeneral.hotwork.002" = "Is a fire watch assigned when required, e.g. combustibles within 35 feet that cannot be relocated (29 CFR 1910.252(a)(2)(iii))?";
// Emergency Action Plan — 29 CFR 1910.38
"checklist.item.usGeneral.eap.001" = "Where an OSHA standard requires one, is there a written emergency action plan covering reporting, evacuation, and employee accountability (29 CFR 1910.38(a), (c))?";
"checklist.item.usGeneral.eap.002" = "Is an employee alarm system with a distinctive signal maintained and understood by employees (29 CFR 1910.38(d))?";

// U.S. Federal — Construction (us-federal-construction-v1)
// Housekeeping — 29 CFR 1926.25
"checklist.item.usConstruction.house.001" = "Is form/scrap lumber with protruding nails and other debris kept cleared from work areas, passageways, and stairs (29 CFR 1926.25(a))?";
// Fall Protection — 29 CFR 1926.501 (6 ft — distinct from general industry's 4 ft threshold)
"checklist.item.usConstruction.fall.001" = "Are unprotected sides or edges 6 feet (1.8 m) or more above a lower level guarded by a guardrail system, safety net, or personal fall arrest system (29 CFR 1926.501(b)(1))?";
"checklist.item.usConstruction.fall.002" = "Are holes, leading edges, and ramps/runways 6 feet (1.8 m) or more above a lower level protected per the applicable provision of 29 CFR 1926.501(b)?";
// Ladders & Scaffolds — 29 CFR 1926.1053 / 1926.451
"checklist.item.usConstruction.ladder.001" = "Do portable ladder side rails extend at least 3 feet (0.9 m) above the upper landing surface (29 CFR 1926.1053(b)(1))?";
"checklist.item.usConstruction.scaffold.001" = "Is each scaffold, and each part of it, designed by a qualified person and capable of supporting at least 4 times the maximum intended load (29 CFR 1926.451(a)(1), (a)(6))?";
"checklist.item.usConstruction.scaffold.002" = "Is the scaffold inspected by a competent person before each work shift and after any occurrence that could affect its structural integrity (29 CFR 1926.451(f)(3))?";
// PPE — 29 CFR 1926.95
"checklist.item.usConstruction.ppe.001" = "Is PPE provided at no cost to employees wherever necessary because of process, environmental, chemical, or mechanical hazards (29 CFR 1926.95(a), (d)(1))?";
// Respiratory Protection — 29 CFR 1926.103 (applies 29 CFR 1910.134 to construction)
"checklist.item.usConstruction.resp.001" = "Where respirators are necessary or required, is a written respiratory protection program maintained per 29 CFR 1910.134, as applied to construction by 29 CFR 1926.103?";
// Hazard Communication — 29 CFR 1926.59 (applies 29 CFR 1910.1200 to construction)
"checklist.item.usConstruction.hazcom.001" = "Are hazardous chemicals on site labeled and are SDS accessible per 29 CFR 1910.1200, as applied to construction by 29 CFR 1926.59?";
// Hand & Power Tools — 29 CFR 1926.300
"checklist.item.usConstruction.tools.001" = "Are power-operated tools designed to accommodate guards equipped with those guards when in use (29 CFR 1926.300(b)(1))?";
// Electrical — 29 CFR 1926.416 / 1926.404
"checklist.item.usConstruction.elec.001" = "Are employees protected from contact with energized circuits by deenergizing and grounding, or by effective guarding (29 CFR 1926.416(a)(1))?";
"checklist.item.usConstruction.elec.002" = "Do temporary 125-volt, single-phase, 15/20/30-amp receptacles that are not part of the permanent wiring have GFCI protection, or does the employer use an Assured Equipment Grounding Conductor Program (29 CFR 1926.404(b)(1))?";
// Lockout/Tagout — 29 CFR 1926.417 (construction has no general multi-energy LOTO standard; scoped to electrical circuits only)
"checklist.item.usConstruction.loto.001" = "Are deenergized circuits and their deactivated controls tagged at every point where they could be re-energized while work is performed on them (29 CFR 1926.417(a), (b))?";
// Powered Industrial Trucks — 29 CFR 1926.602(d) (applies 29 CFR 1910.178(l) to construction)
"checklist.item.usConstruction.pit.001" = "Do only operators who have completed the training required by 29 CFR 1910.178(l), as applied to construction by 29 CFR 1926.602(d), operate powered industrial trucks?";
// Fire Protection — 29 CFR 1926.150
"checklist.item.usConstruction.fire.001" = "Is a fire protection program maintained throughout all phases of the construction and demolition work (29 CFR 1926.150(a)(1))?";
// Hot Work — 29 CFR 1926.352
"checklist.item.usConstruction.hotwork.001" = "Are objects to be welded, cut, or heated moved to a designated safe location, or are heat/sparks/slag confined when they cannot be moved (29 CFR 1926.352(a), (b))?";
"checklist.item.usConstruction.hotwork.002" = "Is a fire watch assigned with suitable fire-extinguishing equipment immediately available (29 CFR 1926.352(d), (e))?";
// Emergency Action Plan — 29 CFR 1926.35
"checklist.item.usConstruction.eap.001" = "Is there a written employee emergency action plan covering evacuation procedures, an alarm system, and employee accountability (29 CFR 1926.35(b), (c))?";


